{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mrmarmac.github.io/apartresearch-ledger/schema.json",
  "title": "Commitment Ledger",
  "description": "Atomic safety-framework commitments of frontier AI developers, each with a stable ID and a history across framework versions.",
  "type": "object",
  "required": ["schema_version", "source", "versions", "commitments"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "source": {
      "type": "object",
      "description": "The upstream coding that this ledger is derived from.",
      "required": ["name", "repo", "commit", "licence", "citation"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "repo": { "type": "string", "format": "uri" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "doi": { "type": "string" },
        "licence": { "type": "string" },
        "citation": { "type": "string" }
      }
    },
    "versions": { "type": "array", "items": { "$ref": "#/$defs/version" } },
    "commitments": { "type": "array", "items": { "$ref": "#/$defs/commitment" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "version_id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9.]+)+$" },
    "commitment_id": {
      "type": "string",
      "description": "{lab}-{topic}-{hash}. Assigned at first appearance. Never regenerated.",
      "pattern": "^[a-z0-9]+-[a-z]+(-[a-z]+)*-[0-9a-f]{4,12}$"
    },
    "status": {
      "description": "The change from the previous traced version to this version.",
      "enum": ["baseline", "added", "kept", "strengthened", "weakened", "removed", "relocated"]
    },
    "version": {
      "type": "object",
      "required": ["version_id", "lab", "document", "label", "publication_date", "source_url", "wayback_timestamp", "sha256"],
      "additionalProperties": false,
      "properties": {
        "version_id": { "$ref": "#/$defs/version_id" },
        "lab": { "type": "string" },
        "lab_name": { "type": "string" },
        "document": { "type": "string" },
        "label": { "type": "string", "description": "The version label that the upstream corpus uses." },
        "publication_date": { "type": "string", "format": "date" },
        "source_url": { "type": "string" },
        "wayback_timestamp": { "type": ["string", "null"], "pattern": "^[0-9]{14}$" },
        "sha256": { "$ref": "#/$defs/sha256", "description": "SHA-256 of the document file as retrieved." },
        "reuploads": {
          "type": "array",
          "description": "Files that the developer published again under the same version label.",
          "items": {
            "type": "object",
            "required": ["label", "sha256", "source_url"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string" },
              "sha256": { "$ref": "#/$defs/sha256" },
              "source_url": { "type": "string" },
              "wayback_timestamp": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "commitment": {
      "type": "object",
      "required": ["id", "lab", "text", "topic", "tags", "current_status", "first_version_id", "last_version_id", "history"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/commitment_id" },
        "lab": { "type": "string" },
        "text": { "type": "string", "description": "The most recent verbatim text of the commitment." },
        "topic": {
          "enum": ["eval-scope", "eval-trigger", "eval-method", "third-party", "disclosure", "consequence", "governance", "security", "mitigation"]
        },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "current_status": {
          "description": "active: in the latest traced version. merged: continues under merged_into. not_traced: the ledger has no record after last_version_id.",
          "enum": ["active", "removed", "relocated", "merged", "not_traced"]
        },
        "merged_into": {
          "description": "ID of the commitment that continues this one, when the upstream coder merged two rows.",
          "anyOf": [{ "$ref": "#/$defs/commitment_id" }, { "type": "null" }]
        },
        "first_version_id": { "$ref": "#/$defs/version_id" },
        "last_version_id": { "$ref": "#/$defs/version_id" },
        "history": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/history_entry" } }
      }
    },
    "history_entry": {
      "type": "object",
      "required": ["event_id", "version_id", "status", "quote", "section", "source_url", "wayback_timestamp", "sha256", "confidence"],
      "additionalProperties": false,
      "properties": {
        "event_id": { "type": "string", "description": "{commitment_id}@{version_id}. Stable. Use it as the RSS GUID." },
        "version_id": { "$ref": "#/$defs/version_id" },
        "status": { "$ref": "#/$defs/status" },
        "quote": { "type": ["string", "null"], "description": "Verbatim text in this version. null when the commitment is removed." },
        "section": { "type": ["string", "null"] },
        "section_changed": { "type": "boolean", "description": "The section heading is different from the previous version." },
        "mixed": { "type": "boolean", "description": "The change makes the commitment stronger in one dimension and weaker in a different dimension. Status is then weakened." },
        "material": { "type": ["boolean", "null"] },
        "disclosure": {
          "description": "Did the developer's own account of the revision identify this change?",
          "enum": ["announced", "partly_announced", "silent", "no_account", "not_applicable", null]
        },
        "confidence": { "enum": ["high", "medium", "low", null] },
        "rationale": { "type": ["string", "null"] },
        "link": {
          "description": "How the ledger connected this entry to the previous entry.",
          "enum": ["prior_id", "exact_text", "fuzzy_text", "same_row", null]
        },
        "gap_before": { "type": "boolean", "description": "One or more versions between the previous entry and this entry are not traced." },
        "quote_verified": { "type": ["boolean", "null"], "description": "The quote is in the text extraction of the hashed document." },
        "source_row": { "type": ["string", "null"], "description": "Row ID in the upstream coding sheet." },
        "source_url": { "type": "string" },
        "wayback_timestamp": { "type": ["string", "null"] },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
